rules_version = '2';

// Audio tracks live at rooms/{room}/tracks/{file}. The real gate on which
// files become selectable is the RTDB `tracks/` node (host-only write), so
// even an uploaded file is invisible in-game without a host-written entry.
service firebase.storage {
  match /b/{bucket}/o {
    // shared, persistent music library (recursive match also allows listing)
    match /library/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
    // legacy per-room uploads (kept readable for older rooms)
    match /rooms/{room}/tracks/{trackFile} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
